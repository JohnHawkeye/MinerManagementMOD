		Items: {
			MinerWhistle: {
				DisplayName: Miner's Whistle
				Tooltip: Summons nearby miners to your side.
			}

			CopperSword100: {
				DisplayName: Box of 100 Copper Swords
				Tooltip: A quest item containing 100 Copper Swords.
			}

			CopperAmberRing: {
				DisplayName: Copper Amber Ring
				Tooltip:
					'''
					A decorative ring crafted from a beautiful gemstone.
					It can be sold for a high price.
					'''
			}

			CopperAmethystRing: {
				DisplayName: Copper Amethyst Ring
				Tooltip:
					'''
					A decorative ring crafted from a beautiful gemstone.
					It can be sold for a high price.
					'''
			}

			CopperDiamondRing: {
				DisplayName: Copper Diamond Ring
				Tooltip:
					'''
					A decorative ring crafted from a beautiful gemstone.
					It can be sold for a high price.
					'''
			}

			CopperEmeraldRing: {
				DisplayName: Copper Emerald Ring
				Tooltip:
					'''
					A decorative ring crafted from a beautiful gemstone.
					It can be sold for a high price.
					'''
			}

			CopperRubyRing: {
				DisplayName: Copper Ruby Ring
				Tooltip:
					'''
					A decorative ring crafted from a beautiful gemstone.
					It can be sold for a high price.
					'''
			}

			CopperSapphireRing: {
				DisplayName: Copper Sapphire Ring
				Tooltip:
					'''
					A decorative ring crafted from a beautiful gemstone.
					It can be sold for a high price.
					'''
			}

			CopperTopazRing: {
				DisplayName: Copper Topaz Ring
				Tooltip:
					'''
					A decorative ring crafted from a beautiful gemstone.
					It can be sold for a high price.
					'''
			}

			BuriedBox: {
				DisplayName: Buried Box
				Tooltip: I wonder what's inside...
			}

			MiningMachineItem: {
				DisplayName: Tier 1 Mining Machine
				Tooltip:
					'''
					Deploys a mining machine at your location.
					It automatically mines nearby ores.
					Right-click with your inventory closed to collect the mined ores.
					'''
			}

			Detonator: {
				DisplayName: Detonator
				Tooltip:
					'''
					A remote detonator for destroying attached remote bombs.
					Use it to detonate the bomb.
					'''
			}

			RemoteBomb: {
				DisplayName: Remote Bomb
				Tooltip: Throw it where you want to place the bomb.
			}

			MagicHand: {
				DisplayName: Magic Hand
				Tooltip: No need to touch it yourself!
			}

			DrillClusterItem: {
				DisplayName: Tier 1 Drill Cluster
				Tooltip:
					'''
					Fires a drill capable of mining blocks.
					Can mine Hellstone.
					'''
			}

			CrystalVacuum: {
				DisplayName: Crystal Vacuum
				Tooltip:
					'''
					The one and only vacuum with unchanging suction power.
					Sucks up crystals from wherever you click.
					'''
			}

			DrillRocket: {
				DisplayName: Drill Rocket
				Tooltip: Ammunition for the Drill Cluster.
			}

			DrillRocket2: {
				DisplayName: Drill Rocket 2
				Tooltip:
					'''
					A mithril-coated drill.
					Allows the Drill Cluster to mine Hardmode ores.
					'''
			}

			RemoteBomb2: {
				DisplayName: Remote Bomb Type 2
				Tooltip: An upgraded remote bomb capable of destroying Hellstone and Meteorite.
			}

			BioBombItem: {
				DisplayName: Biome Bomb
				Tooltip: Creates blocks matching the surrounding biome where it lands.
			}

			CopperMinerCoin: {
				DisplayName: Miner Medal (Copper)
				Tooltip:
					'''
					A proud miner's medal.
					Used for crafting and upgrading miners.
					'''
			}

			SilverMinerCoin: {
				DisplayName: Miner Medal (Silver)
				Tooltip:
					'''
					A proud miner's medal.
					Used for crafting and upgrading miners.
					'''
			}

			GoldMinerCoin: {
				DisplayName: Miner Medal (Gold)
				Tooltip:
					'''
					A proud miner's medal.
					Used for crafting and upgrading miners.
					'''
			}

			PlatinumMinerCoin: {
				DisplayName: Miner Medal (Platinum)
				Tooltip:
					'''
					A proud miner's medal.
					Used for crafting and upgrading miners.
					'''
			}

			TopazCrabStone: {
				DisplayName: Topaz Crab Stone
				Tooltip: Summons the Topaz Crab.
			}

			CrabClaw: {
				DisplayName: Crab Claw
				Tooltip: A delicious-looking crab claw.
			}

			FoolTicket: {
				DisplayName: Losing Ticket
				Tooltip: Better luck next time. You lose!
			}

			LockPick: {
				DisplayName: Lockpick
				Tooltip: Unlocks locked Gold Chests.
			}

			SlotMachine: {
				DisplayName: Slot Machine
				Tooltip: The beginning of a lifelong gambling addiction...
			}

			TradeExchangeMachine: {
				DisplayName: Ore Exchange Machine
				Tooltip:
					'''
					Exchanges matching ores or bars.
					Requires Copper Miner Coins.
					'''
			}

			MinerBlessingPotion: {
				DisplayName: Miner's Blessing Potion
				Tooltip: The blessing of the Mining King grants you tremendous power...!
			}

			SlopeAccessory: {
				DisplayName: Rolling Slope
				Tooltip: Rounds off the corners of blocks as you walk.
			}

			OreSeed: {
				DisplayName: Magical Ore Seed
				Tooltip: A mysterious seed that grows ore when planted in Stone Blocks.
			}

			StoneBomb: {
				DisplayName: Stone Bomb
				Tooltip: Creates Stone Blocks at the location you target.
			}

			SkyIslandMap: {
				DisplayName: Sky Island Map
				Tooltip: Reveals the locations of Sky Islands when used.
			}

			DungeonMap: {
				DisplayName: Dungeon Map
				Tooltip: Reveals the interior of the Dungeon when used.
			}

			MastarsBaton: {
				DisplayName: Master's Baton
				Tooltip: Commands your guards to deploy or retreat.
			}

			StoneWand: {
				DisplayName: Stone Wand
				Tooltip: Consumes Stone Blocks from your inventory to place them where you click.
			}

			RainbowJewel: {
				DisplayName: Rainbow Jewel
				Tooltip:
					'''
					A beautiful gemstone that shines with every color of the rainbow.
					Offer it to the Jewel Dragon to increase the power of its buff.
					'''
			}

			PinkyWormItem: {
				DisplayName: Pinky Worm Egg
				Tooltip:
					'''
					Allows you to transform deep underground.
					Dig through the earth as a worm and feel the life of an ore miner!
					'''
			}

			MossHornetMountItem: {
				DisplayName: Soul of the Giant Moss Hornet
				Tooltip:
					'''
					Transforms you into a Moss Hornet from the Jungle.
					Left-click to fire poisonous stingers.
					'''
			}

			GreedCompass: {
				DisplayName: Greed Compass
				Tooltip:
					'''
					A magical compass that points toward nearby chests.
					Be careful—it also reacts to chests you place yourself.
					Collect the contents, then retrieve the chest.
					'''
			}

			MobileTracker: {
				DisplayName: Mobile Tracker
				Tooltip:
					'''
					A 3D printer that lets you craft rails anywhere with the required materials.
					It can also craft other components.
					'''
			}

			MinerBaseItem: {
				DisplayName: Miner Base Flag
				Tooltip:
					'''
					A flag marking your home base.
					Place an Outpost along with it to teleport back to your base.
					'''
			}

			MinerOutpostItem: {
				DisplayName: Miner Outpost Sign
				Tooltip: Place it at an expedition site to instantly return to the location of your Miner Base Flag.
			}

			ReturnEmblem: {
				DisplayName: Return Emblem
				Tooltip:
					'''
					Teleports you to the nearest registered Outpost.
					Cannot be used if the Outpost is more than 3,000 blocks away.
					'''
			}

			HoppingTrackItem: {
				DisplayName: Hopping Track
				Tooltip: A special rail that launches you into the air as you pass over it.
			}

			BlackSmithArmor: {
				DisplayName: Blacksmith Armor
				Tooltip:
					'''
					Armor worn by a noble blacksmith.
					Wearing the full set increases mining range by 3.
					'''
			}

			BlackSmithHat: {
				DisplayName: Blacksmith Hat
				Tooltip:
					'''
					A hat worn by a noble blacksmith.
					Wearing the full set increases mining range by 3.
					'''
			}

			BlackSmithLeggings: {
				DisplayName: Blacksmith Leggings
				Tooltip:
					'''
					Leggings worn by a noble blacksmith.
					Wearing the full set increases mining range by 3.
					'''
			}
		}

